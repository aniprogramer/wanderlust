<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Main layout head: meta tags, external CSS, fonts, and local styles -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>Wanderlust</title>

    <!-- Brand Favicon & Web Manifest -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/assets/favicon-180x180.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <%- include("../includes/seoTags.ejs") %>
    <meta name="theme-color" content="<%= themeColor %>" />

    <!-- Self-hosted libraries: see public/vendor -->
    <link rel="stylesheet" href="/vendor/bootstrap/5.3.8/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/fontawesome/7.0.1/css/all.min.css" />

    <!-- Self-hosted fonts (see @font-face in style.css) -->
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Local stylesheets -->
    <link rel="stylesheet" href="<%= asset('/css/tokens.css') %>" />
    <%- block("vendorCss").toString() %>
    <link rel="stylesheet" href="<%= asset('/css/style.css') %>" />
  </head>
  <body class="<%= typeof isAuthPage !== 'undefined' && isAuthPage ? 'wl-auth-body' : (typeof isHomePage !== 'undefined' && isHomePage ? 'wl-home-body' : 'wl-rail-body') %>">
    <a class="wl-skip-link" href="#main-content">Skip to content</a>
    <%- include("../includes/flash.ejs") %>
    <% if (typeof isAuthPage !== 'undefined' && isAuthPage) { %>
      <%- body %>
    <% } else if (typeof isHomePage !== 'undefined' && isHomePage) { %>
      <div class="wl-app-shell">
        <%- include("../includes/sidebar.ejs") %>
        <main class="wl-main-canvas" id="main-content">
          <%- body %>
          <%- include("../includes/footer.ejs") %>
        </main>
      </div>
    <% } else { %>
      <!-- Site navigation: included EJS partial -->
      <%- include("../includes/navbar.ejs") %>
      <!-- The same floating rail as home, from 993px up -->
      <%- include("../includes/sidebar.ejs") %>

      <!-- Page container: shows flash messages and the page-specific body -->
      <main class="container wl-shell-main" id="main-content">
        <%- body %>
      </main>

      <!-- Site footer: included EJS partial -->
      <%- include("../includes/footer.ejs") %>
    <% } %>

    <!-- Scripts: Bootstrap JS bundle and local JS -->
    <script src="/vendor/bootstrap/5.3.8/bootstrap.bundle.min.js"></script>
    <script src="<%= asset('/js/script.js') %>"></script>
    <script src="<%= asset('/js/datepicker.js') %>"></script>
    <script src="<%= asset('/js/flash.js') %>"></script>
    <script src="<%= asset('/js/confirm.js') %>"></script>
    <script src="<%= asset('/js/auth.js') %>"></script>
  </body>
</html>
