<% layout("/layouts/boilerplate") %>

<h3 id="show-page-h3"><%= listing.title %> Details</h3>

<div class="container">
  <!-- Listing Card -->
  <div class="card show-card mb-5">
    <div class="row g-4">
      <!-- LEFT: Image -->
      <div class="col-12 col-md-6">
        <img
          src="<%= listing.image.url %>"
          alt="listing-image"
          class="img-fluid rounded-start"
        />
      </div>

      <!-- RIGHT: Details -->
      <div class="col-12 col-md-6 ps-md-4">
        <div class="card-body">
          <p class="card-text">
            Listed By:
            <i><u><%= listing.owner.username %></u></i>
          </p>
          <p class="card-text"><%= listing.description %></p>

          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-currency-rupee me-2 text-muted"></i>
              <strong class="me-1">Price:</strong>
              <%= listing.price.toLocaleString("en-IN") %>
              / night
            </li>

            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-geo-alt me-2 text-muted"></i>
              <strong class="me-1">Location:</strong>
              <%= listing.location %>
            </li>

            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-globe me-2 text-muted"></i>
              <strong class="me-1">Country:</strong>
              <%= listing.country %>
            </li>
          </ul>

          <!-- Action Buttons -->
          <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
          <div class="card-btn d-flex gap-2">
            <form action="/listings/<%= listing._id %>/edit" method="GET">
              <button type="submit" class="btn btn-dark show-btn">
                <i class="bi bi-pencil-square me-1"></i>
                Edit
              </button>
            </form>

            <form
              action="/listings/<%= listing._id %>?_method=DELETE"
              method="POST"
              onsubmit="
                return confirm('Are you sure you want to delete this listing?');
              "
            >
              <button type="submit" class="btn btn-danger show-btn">
                <i class="bi bi-trash me-1"></i>
                Delete Listing
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border">
        <div class="card-body p-4">
          <% if (currUser) { %>
          <h4 class="card-title mb-4">Leave a Review</h4>

          <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            class="needs-validation"
            novalidate
          >
            <!-- Rating -->
            <div class="mb-4">
              <label class="form-label fw-medium d-block mb-2">Rating</label>

              <div class="star-rating">
                <% for (let i = 5; i >= 1; i--) { %>
                <input
                  type="radio"
                  id="star-<%= i %>"
                  value="<%= i %>"
                  name="review[rating]"
                  required
                />
                <label for="star-<%= i %>" title="<%= i %> stars">★</label>
                <% } %>
              </div>
            </div>

            <!-- Comment -->
            <div class="mb-4">
              <label for="comment" class="form-label fw-medium">Comments</label>

              <textarea
                id="comment"
                name="review[comment]"
                class="form-control"
                rows="5"
                placeholder="Share your experience..."
                required
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="text-end">
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-send me-2"></i>
                Add Review
              </button>
            </div>
          </form>
          <% } %>

          <hr />

          <!-- All Reviews -->
          <h4 class="mb-4 fw-semibold">All Reviews</h4>

          <div class="row g-4">
            <% listing.reviews.forEach((review) => { %>
            <div class="col-12 col-md-6">
              <div class="review-card p-4 h-100">
                <!-- Header -->
                <div class="d-flex align-items-center mb-3">
                  <div class="review-avatar me-3">
                    <i class="bi bi-person-fill"></i>
                  </div>

                  <div>
                    <h6 class="mb-0 fw-semibold">
                      @<%= review.author.username %>
                    </h6>
                    <div class="review-stars">
                      <% for (let i = 1; i <= review.rating; i++) { %> ★ <% } %>
                    </div>
                  </div>
                </div>

                <!-- Review Text -->
                <p class="review-text mb-4"><%= review.comment %></p>

                <!-- Actions -->
                <form
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="POST"
                >
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
