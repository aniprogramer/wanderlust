<% layout("/layouts/boilerplate") %>

<h3 id="show-page-h3"><%= listing.title %> Details</h3>

<div class="container">
  <!-- Listing Card -->
  <div class="card show-card mb-5">
    <div class="row g-4">
      <!-- LEFT: Image -->
      <div class="col-12 col-md-6">
        <img
          src="<%= listing.image.url %>"
          alt="listing-image"
          class="img-fluid rounded-start"
        />
      </div>

      <!-- RIGHT: Details -->
      <div class="col-12 col-md-6 ps-md-4">
        <div class="card-body">
          <p class="card-text">
            Listed By:
            <i><u><%= listing.owner ? listing.owner.username : "Unknown host" %></u></i>
          </p>
          <p class="card-text"><%= listing.description %></p>

          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-cash me-2 text-muted"></i>
              <strong class="me-1">Price:</strong>
              <%= money(listing.price, listing.currency) %>
              / night
            </li>

            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-geo-alt me-2 text-muted"></i>
              <strong class="me-1">Location:</strong>
              <%= listing.location %>
            </li>

            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-globe me-2 text-muted"></i>
              <strong class="me-1">Country:</strong>
              <%= listing.country %>
            </li>

            <% if (listing.category || listing.propertyType) { %>
            <li class="list-group-item d-flex align-items-center flex-wrap gap-2">
              <i class="bi bi-tag me-2 text-muted"></i>
              <% if (listing.category) { %>
              <a class="badge text-bg-light border text-decoration-none" href="/listings?category=<%= encodeURIComponent(listing.category) %>"><%= listing.category %></a>
              <% } %>
              <% if (listing.propertyType) { %>
              <a class="badge text-bg-light border text-decoration-none" href="/listings?propertyType=<%= encodeURIComponent(listing.propertyType) %>"><%= listing.propertyType %></a>
              <% } %>
            </li>
            <% } %>

            <% if (listing.reviewCount) { %>
            <li class="list-group-item d-flex align-items-center">
              <i class="bi bi-star-fill me-2 text-warning"></i>
              <strong class="me-1"><%= listing.avgRating.toFixed(1) %></strong>
              (<%= listing.reviewCount %> review<%= listing.reviewCount === 1 ? "" : "s" %>)
            </li>
            <% } %>
          </ul>

          <!-- Action Buttons -->
          <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
          <div class="card-btn d-flex gap-2">
            <form action="/listings/<%= listing._id %>/edit" method="GET">
              <button type="submit" class="btn btn-dark show-btn">
                <i class="bi bi-pencil-square me-1"></i>
                Edit
              </button>
            </form>

            <form
              action="/listings/<%= listing._id %>?_method=DELETE"
              method="POST"
              data-confirm="Are you sure you want to delete this listing?"
            >
              <%- include("../includes/csrf.ejs") %>
              <button type="submit" class="btn btn-danger show-btn">
                <i class="bi bi-trash me-1"></i>
                Delete Listing
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% const isHost = currUser && listing.owner && currUser._id.equals(listing.owner._id); %>

  <!-- Booking -->
  <div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-8">
      <div class="card border p-4" id="booking-card">
        <h4 class="mb-3">Book your stay</h4>
        <% if (isHost) { %>
        <p class="text-muted mb-0">
          This is your listing. Manage guests under
          <a href="/bookings/hosting">Hosting</a>.
        </p>
        <% } else { %>
        <form
          action="/listings/<%= listing._id %>/bookings"
          method="POST"
          id="booking-form"
          data-price="<%= listing.price %>"
          data-currency="<%= listing.currency %>"
          data-booked="<%= JSON.stringify(bookedNights) %>"
          data-today="<%= serverToday %>"
        >
          <% if (currUser) { %><%- include("../includes/csrf.ejs") %><% } %>
          <input id="date-range" class="form-control mb-2" aria-label="Select dates" readonly />
          <input type="hidden" name="booking[checkIn]" />
          <input type="hidden" name="booking[checkOut]" />
          <div class="booking-legend small text-muted mb-2">
            <span class="legend-dot booked"></span> Unavailable
            <span class="legend-dot selected ms-3"></span> Selected
          </div>
          <p id="booking-summary" class="fw-medium mb-3" aria-live="polite"></p>
          <% if (currUser) { %>
          <button type="submit" class="btn btn-dark wanderlust-btn m-0" id="reserve-btn" disabled>Reserve</button>
          <% } else { %>
          <a href="/login" class="btn btn-dark wanderlust-btn m-0">Log in to reserve</a>
          <% } %>
        </form>
        <% } %>

        <% if (bookings.length) { %>
        <hr />
        <h6 class="fw-semibold"><%= isHost ? "Upcoming reservations" : "Unavailable dates" %></h6>
        <ul class="list-unstyled mb-0 small">
          <% bookings.forEach((b) => { %>
          <li class="d-flex flex-wrap align-items-center gap-2 py-1">
            <i class="bi bi-calendar-event text-muted"></i>
            <%= b.checkIn.toISOString().slice(0, 10) %> → <%= b.checkOut.toISOString().slice(0, 10) %>
            <% if (isHost) { %>
            <span class="text-muted">· @<%= b.guest ? b.guest.username : "guest" %> · <%= money(b.totalPrice, listing.currency) %></span>
            <form action="/bookings/<%= b._id %>?_method=DELETE" method="POST" class="ms-auto" data-confirm="Cancel this reservation?">
              <%- include("../includes/csrf.ejs") %>
              <button class="btn btn-sm btn-outline-danger">Cancel</button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Map -->
  <% if (mapboxToken && listing.geometry && listing.geometry.coordinates) { %>
  <div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-8">
      <h4 class="mb-3">Where you'll be</h4>
      <%- include("../includes/mapbox.ejs") %>
      <div
        id="map"
        class="wl-map"
        data-mode="show"
        data-token="<%= mapboxToken %>"
        data-lng="<%= listing.geometry.coordinates[0] %>"
        data-lat="<%= listing.geometry.coordinates[1] %>"
        data-title="<%= listing.title %>"
      ></div>
      <p class="text-muted small mt-2 mb-0"><%= listing.location %>, <%= listing.country %></p>
    </div>
  </div>
  <% } %>

  <!-- Reviews Section -->
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border">
        <div class="card-body p-4">
          <% if (currUser) { %>
          <h4 class="card-title mb-4">Leave a Review</h4>

          <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            class="needs-validation"
            novalidate
          >
            <%- include("../includes/csrf.ejs") %>
            <!-- Rating -->
            <div class="mb-4">
              <label class="form-label fw-medium d-block mb-2">Rating</label>

              <div class="star-rating">
                <% for (let i = 5; i >= 1; i--) { %>
                <input
                  type="radio"
                  id="star-<%= i %>"
                  value="<%= i %>"
                  name="review[rating]"
                  required
                />
                <label for="star-<%= i %>" title="<%= i %> stars">★</label>
                <% } %>
              </div>
            </div>

            <!-- Comment -->
            <div class="mb-4">
              <label for="comment" class="form-label fw-medium">Comments</label>

              <textarea
                id="comment"
                name="review[comment]"
                class="form-control"
                rows="5"
                placeholder="Share your experience..."
                required
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="text-end">
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-send me-2"></i>
                Add Review
              </button>
            </div>
          </form>
          <% } %>

          <hr />

          <!-- All Reviews -->
          <h4 class="mb-4 fw-semibold">All Reviews</h4>

          <div class="row g-4">
            <% listing.reviews.forEach((review) => { %>
            <div class="col-12 col-md-6">
              <div class="review-card p-4 h-100">
                <!-- Header -->
                <div class="d-flex align-items-center mb-3">
                  <div class="review-avatar me-3">
                    <i class="bi bi-person-fill"></i>
                  </div>

                  <div>
                    <h6 class="mb-0 fw-semibold">
                      @<%= review.author ? review.author.username : "traveler" %>
                    </h6>
                    <div class="review-stars">
                      <% for (let i = 1; i <= review.rating; i++) { %> ★ <% } %>
                    </div>
                  </div>
                </div>

                <!-- Review Text -->
                <p class="review-text mb-4"><%= review.comment %></p>

                <!-- Actions -->
                <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                <form
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="POST"
                >
                  <%- include("../includes/csrf.ejs") %>
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script src="/js/booking.js" defer></script>
