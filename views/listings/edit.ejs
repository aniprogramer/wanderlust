<% layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 id="edit-page-h3">Update <b><%= listing.title %></b> Listing</h3>
      <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            value="<%= listing.title %>"
            class="form-control"
            required
          />
        </div>

        <div class="mb-3">
          <label for="desc" class="form-label">Description</label>
          <textarea id="desc" name="listing[description]" class="form-control">
<%= listing.description %></textarea
          >
        </div>

        <div class="mb-3">
          <label for="img" class="form-label">Image Link</label>
          <input
            type="url"
            id="img"
            name="listing[image][url]"
            value="<%= listing.image.url %>"
            class="form-control"
          />
        </div>

        <div class="row">
          <div class="mb-3 col-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="number"
              id="price"
              name="listing[price]"
              value="<%= listing.price %>"
              class="form-control"
            />
          </div>

          <div class="mb-3 col-8">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              value="<%= listing.country %>"
              class="form-control"
            />
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            value="<%= listing.location %>"
            class="form-control"
          />
        </div>

        <button type="submit" class="btn btn-dark wanderlust-btn">
          Update Listing
        </button>
      </form>
    </div>
  </div>
</body>
