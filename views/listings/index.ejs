<% layout("/layouts/boilerplate") %>

<!-- ==============================================
     HERO SECTION WITH TOP HEADER & OVERLAPPING SEARCH
     ============================================== -->
<section class="wl-hero-section position-relative">
  <div class="wl-hero-fade" aria-hidden="true"></div>
  <!-- Top Navigation Header Controls (Inside Hero) -->
  <header class="wl-hero-header d-flex justify-content-between align-items-center w-100 px-3 px-md-4 py-3">
    <!-- Brand link & primary top links (Stays, Experiences, Destinations) -->
    <div class="wl-top-brand-area d-flex align-items-center gap-4">
      <a href="/listings" class="wl-brand-link d-inline-flex align-items-center gap-2 text-decoration-none" aria-label="Wanderlust Home">
        <%- include("../includes/auth/mark", { size: 28, cls: "wl-brand-mark-gold" }) %>
        <span class="wl-brand-name fs-4">Wanderlust</span>
      </a>
      <div class="wl-top-nav-links d-none d-md-flex align-items-center gap-3 ms-2">
        <a href="/listings" class="wl-nav-link-top text-decoration-none fw-medium active">Stays</a>
        <a href="/listings?category=Trending" class="wl-nav-link-top text-decoration-none fw-medium">Experiences</a>
        <a href="/listings/map" class="wl-nav-link-top text-decoration-none fw-medium">Destinations</a>
      </div>
    </div>

    <!-- Center Compact Capsule Search Bar -->
    <form action="/listings" method="GET" class="wl-topbar-search-form d-none d-xl-flex align-items-center mx-3 flex-grow-1 justify-content-center" role="search">
      <div class="wl-topbar-search glass-input glass-pill d-flex align-items-center px-3 py-2">
        <i class="fa-solid fa-magnifying-glass wl-topbar-search-icon me-2" aria-hidden="true"></i>
        <input
          type="search"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Search destinations, stays or experiences"
          aria-label="Search destinations, stays or experiences"
          class="wl-topbar-search-input border-0 bg-transparent text-reset"
          autocomplete="off"
        />
      </div>
    </form>

    <!-- Top Right Actions -->
    <div class="wl-hero-top-actions ms-auto d-flex align-items-center gap-2 gap-md-3">
      <%- include("../includes/currencyDropdown") %>

      <%- include("../includes/modeSwitch", { cls: "wl-hero-pill-btn d-none d-sm-inline-flex" }) %>

      <!-- User Account Dropdown -->
      <div class="dropdown">
        <button
          class="wl-hero-avatar-btn glass-action"
          type="button"
          id="userMenuBtn"
          data-bs-toggle="dropdown"
          data-bs-offset="[0, 10]"
          aria-expanded="false"
          aria-label="User Account Menu"
        >
          <% if (currUser) { %>
            <div class="wl-avatar-circle user-logged-in">
              <%= currUser.username.slice(0, 1).toUpperCase() %>
            </div>
          <% } else { %>
            <div class="wl-avatar-circle">
              <i class="fa-regular fa-user" aria-hidden="true"></i>
            </div>
          <% } %>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg glass-dropdown wl-dropdown-menu" aria-labelledby="userMenuBtn">
          <% if (!currUser) { %>
            <li><a class="dropdown-item py-2" href="/login"><b>Log in</b></a></li>
            <li><a class="dropdown-item py-2" href="/signup">Sign up</a></li>
          <% } else { %>
            <li class="dropdown-header fw-bold">Hello, <%= currUser.username %></li>
            <% navLinks.forEach((link) => { %>
            <li class="d-lg-none"><a class="dropdown-item py-2" href="<%= link.href %>"><i class="<%= link.icon %> me-2" aria-hidden="true"></i><%= link.label %></a></li>
            <% }) %>
            <li class="d-lg-none"><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item py-2" href="/users/<%= encodeURIComponent(currUser.username) %>"><i class="fa-regular fa-id-card me-2" aria-hidden="true"></i>Profile</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <form action="/logout" method="POST" class="m-0">
                <%- include("../includes/csrf.ejs") %>
                <button type="submit" class="dropdown-item py-2 wl-dropdown-item-danger"><b>Log out</b></button>
              </form>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </header>

  <!-- Hero Editorial Headline & Copy -->
  <div class="wl-hero-body">
    <div class="wl-hero-eyebrow">
      STAYS &middot; CABINS &middot; VILLAS
    </div>
    <h1 class="wl-hero-headline">
      Stays worth<br />
      <em>the journey.</em>
    </h1>
    <p class="wl-hero-subtitle">
      Homes, cabins and villas around the world. Send a request and the host confirms your stay.
    </p>
  </div>

  <!-- Overlapping Destination Search Panel -->
  <div class="wl-search-wrapper">
    <form action="/listings" method="GET" class="wl-search-panel glass-surface glass-pill" role="search" id="hero-search-form">
      <!-- Field 1: Destination -->
      <div class="wl-search-field wl-field-destination">
        <i class="fa-solid fa-location-dot wl-search-icon" aria-hidden="true"></i>
        <div class="wl-field-text">
          <label for="search-box" class="wl-field-label">Where to?</label>
          <input
            type="search"
            id="search-box"
            name="q"
            value="<%= filters.q || '' %>"
            placeholder="Search destinations"
            maxlength="100"
            autocomplete="off"
            class="wl-field-input"
          />
        </div>
      </div>

      <div class="wl-field-divider d-none d-md-block"></div>

      <!-- Field 2: Check in -->
      <div class="wl-search-field wl-field-date" id="check-in-field" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" aria-label="Check in: <%= filters.checkIn || 'add date' %>" data-label="Check in">
        <i class="fa-regular fa-calendar wl-search-icon" aria-hidden="true"></i>
        <div class="wl-field-text">
          <span class="wl-field-label">Check in</span>
          <span class="wl-field-input wl-date-value <%= filters.checkIn ? '' : 'is-empty' %>" data-date-value><%= filters.checkIn || 'Add date' %></span>
          <input type="hidden" id="check-in-input" name="checkIn" value="<%= filters.checkIn || '' %>" />
        </div>
      </div>

      <div class="wl-field-divider d-none d-md-block"></div>

      <!-- Field 3: Check out -->
      <div class="wl-search-field wl-field-date" id="check-out-field" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" aria-label="Check out: <%= filters.checkOut || 'add date' %>" data-label="Check out">
        <i class="fa-regular fa-calendar wl-search-icon" aria-hidden="true"></i>
        <div class="wl-field-text">
          <span class="wl-field-label">Check out</span>
          <span class="wl-field-input wl-date-value <%= filters.checkOut ? '' : 'is-empty' %>" data-date-value><%= filters.checkOut || 'Add date' %></span>
          <input type="hidden" id="check-out-input" name="checkOut" value="<%= filters.checkOut || '' %>" />
        </div>
      </div>

      <div class="wl-field-divider d-none d-lg-block"></div>

      <!-- Field 4: Guests (Custom Wanderlust Selector) -->
      <div class="wl-search-field wl-field-guests position-relative" id="guests-field">
        <i class="fa-regular fa-user wl-search-icon"></i>
        <div class="wl-field-text">
          <label for="guests-trigger-btn" id="guests-label" class="wl-field-label">Guests</label>
          <button
            type="button"
            id="guests-trigger-btn"
            class="wl-field-btn d-flex align-items-center justify-content-between w-100 p-0 border-0 bg-transparent text-start"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-labelledby="guests-label guests-display"
          >
            <span id="guests-display"><%= !filters.guests ? "Add guests" : filters.guests == 1 ? "1 guest" : filters.guests + " guests" %></span>
            <i class="fa-solid fa-chevron-down wl-chevron-icon ms-1" aria-hidden="true"></i>
          </button>
          <input type="hidden" name="guests" id="guests-input" value="<%= filters.guests || '' %>" />
        </div>

        <!-- Custom Branded Guests Popover Panel -->
        <div class="wl-guests-popover shadow-lg glass-popover" id="guests-popover" role="dialog" aria-modal="false" aria-label="Guests selector" hidden>
          <div class="wl-guests-header mb-3">
            <span class="wl-guests-title d-block fw-bold">Guests</span>
            <span class="wl-guests-subtitle small text-muted">Up to 16 guests</span>
          </div>

          <!-- Adults counter -->
          <div class="wl-guest-row d-flex align-items-center justify-content-between py-2 border-bottom">
            <div class="wl-guest-info">
              <div class="wl-guest-type fw-semibold">Adults</div>
              <div class="wl-guest-desc small text-muted">Ages 13 or above</div>
            </div>
            <div class="wl-guest-stepper d-flex align-items-center gap-3">
              <button type="button" class="wl-stepper-btn" id="adults-dec-btn" aria-label="Decrease adults" data-action="dec" data-type="adults">
                <i class="fa-solid fa-minus" aria-hidden="true"></i>
              </button>
              <span class="wl-stepper-count fw-bold" id="adults-count"><%= filters.guests || 1 %></span>
              <button type="button" class="wl-stepper-btn" id="adults-inc-btn" aria-label="Increase adults" data-action="inc" data-type="adults">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <!-- Children counter -->
          <div class="wl-guest-row d-flex align-items-center justify-content-between py-2 border-bottom">
            <div class="wl-guest-info">
              <div class="wl-guest-type fw-semibold">Children</div>
              <div class="wl-guest-desc small text-muted">Ages 0 to 12</div>
            </div>
            <div class="wl-guest-stepper d-flex align-items-center gap-3">
              <button type="button" class="wl-stepper-btn" id="children-dec-btn" aria-label="Decrease children" data-action="dec" data-type="children" disabled>
                <i class="fa-solid fa-minus" aria-hidden="true"></i>
              </button>
              <span class="wl-stepper-count fw-bold" id="children-count">0</span>
              <button type="button" class="wl-stepper-btn" id="children-inc-btn" aria-label="Increase children" data-action="inc" data-type="children">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <div class="wl-guests-footer d-flex justify-content-end pt-3">
            <button type="button" class="btn btn-sm wl-btn-done" id="guests-done-btn">Done</button>
          </div>
        </div>
      </div>

      <!-- Submit Action Button: Magnifying Glass in Primary Teal -->
      <div class="wl-search-action">
        <button type="submit" class="wl-search-btn" aria-label="Search Stays">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>

      <!-- Custom Premium Date Range Picker Popover Panel -->
      <div class="wl-calendar-popover shadow-lg glass-popover" id="calendar-popover" role="dialog" aria-modal="true" aria-label="Choose stay dates. Dates are local to the property." data-today="<%= serverToday %>" hidden>
        <!-- Injected and managed by datepicker.js -->
      </div>
    </form>
  </div>
</section>

<!-- ==============================================
     HORIZONTAL DESTINATION CATEGORIES STRIP
     ============================================== -->
<section class="wl-categories-section">
  <div class="wl-categories-container">
    <div class="wl-categories-track" id="categoryTrack">
      <% for (const cat of uiCategories) { %>
        <%
          const isSelected = (!cat.categoryParam && !filters.category) || (cat.categoryParam && filters.category === cat.categoryParam);
          const targetUrl = cat.categoryParam
            ? `/listings${qs({ category: cat.categoryParam, page: undefined })}`
            : `/listings${qs({ category: undefined, page: undefined })}`;
        %>
        <a href="<%= targetUrl %>" class="wl-category-item <%= isSelected ? 'selected' : '' %> text-decoration-none">
          <div class="wl-cat-thumb-wrapper position-relative">
            <img src="<%= cat.image %>" alt="<%= cat.label %>" class="wl-cat-thumb" loading="lazy" />
          </div>
          <span class="wl-cat-label"><%= cat.label %></span>
        </a>
      <% } %>
    </div>
    <!-- Right arrow scroll button -->
    <button class="wl-cat-nav-btn" id="catScrollRight" aria-label="Scroll Categories Right">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</section>

<!-- ==============================================
     CURATED FOR YOU / EXCEPTIONAL STAYS SECTION
     ============================================== -->
<section class="wl-featured-section" id="explore-stays">
  <!-- Section Header -->
  <div class="wl-featured-header d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
      <span class="wl-featured-eyebrow">PLACES TO STAY</span>
      <h2 class="wl-featured-title">Places to stay</h2>
    </div>

    <!-- Discovery Controls -->
    <div class="wl-featured-controls d-flex align-items-center gap-3">
      <!-- Stays Count -->
      <span class="wl-stays-count text-muted fw-semibold"><%= total === 1 ? '1 stay' : total + ' stays' %></span>

      <!-- View All Stays Link -->
      <a href="/listings" class="wl-view-all-link text-decoration-none d-none d-md-inline-flex align-items-center gap-1">
        <span>View all stays</span>
        <i class="fa-solid fa-arrow-right small"></i>
      </a>

      <!-- Previous / Next Pagination Arrow Controls -->
      <div class="wl-arrow-controls d-flex align-items-center gap-1">
        <% if (page > 1) { %>
          <a href="/listings<%= qs({ page: page - 1 }) %>" class="wl-nav-circle-btn" aria-label="Previous Page">
            <i class="fa-solid fa-chevron-left"></i>
          </a>
        <% } else { %>
          <span class="wl-nav-circle-btn disabled" aria-hidden="true">
            <i class="fa-solid fa-chevron-left"></i>
          </span>
        <% } %>

        <% if (page < pages) { %>
          <a href="/listings<%= qs({ page: page + 1 }) %>" class="wl-nav-circle-btn" aria-label="Next Page">
            <i class="fa-solid fa-chevron-right"></i>
          </a>
        <% } else { %>
          <span class="wl-nav-circle-btn disabled" aria-hidden="true">
            <i class="fa-solid fa-chevron-right"></i>
          </span>
        <% } %>
      </div>

      <!-- Advanced Filter Drawer Toggle -->
      <button
        class="wl-pill-outline-btn"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#advancedFilterPanel"
        aria-expanded="false"
        aria-controls="advancedFilterPanel"
      >
        <i class="fa-solid fa-sliders me-1"></i>
        <span>Filters</span>
      </button>

      <!-- View on Map Button -->
      <a href="/listings/map<%= qs({ page: undefined }) %>" class="wl-pill-outline-btn text-decoration-none">
        <i class="fa-solid fa-map me-1"></i>
        <span>View on map</span>
      </a>
    </div>
  </div>

  <!-- Collapsible Advanced Filters Drawer -->
  <div class="collapse mb-4" id="advancedFilterPanel">
    <form action="/listings" method="GET" class="card card-body filter-panel p-4 shadow-sm border-0 rounded-4">
      <%# Keeps what the other controls chose, so applying a filter never drops them %>
      <% for (const key of ["guests", "checkIn", "checkOut", "category", "propertyType"]) { %>
        <% if (filters[key]) { %><input type="hidden" name="<%= key %>" value="<%= filters[key] %>" /><% } %>
      <% } %>
      <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-bold small" for="f-q">Keywords</label>
          <input class="form-control" id="f-q" name="q" value="<%= filters.q || '' %>" placeholder="Title, place, description" maxlength="100" />
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-bold small" for="f-country">Country</label>
          <select class="form-select" id="f-country" name="country">
            <option value="">Any Country</option>
            <% for (const c of countries) { %>
              <option value="<%= c %>" <%= filters.country === c ? "selected" : "" %>><%= c %></option>
            <% } %>
          </select>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
          <label class="form-label fw-bold small" for="f-currency">Price in</label>
          <select class="form-select" id="f-currency" name="currency">
            <% for (const code of currencies) { %>
              <option value="<%= code %>" <%= (filters.currency || "INR") === code ? "selected" : "" %>><%= code %></option>
            <% } %>
          </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <label class="form-label fw-bold small" for="f-min">Min price (<%= filters.currency || "INR" %>)</label>
          <input type="number" class="form-control" id="f-min" name="minPrice" value="<%= filters.minPrice != null ? filters.minPrice : '' %>" min="0" placeholder="0" />
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <label class="form-label fw-bold small" for="f-max">Max price (<%= filters.currency || "INR" %>)</label>
          <input type="number" class="form-control" id="f-max" name="maxPrice" value="<%= filters.maxPrice != null ? filters.maxPrice : '' %>" min="0" placeholder="No max" />
        </div>
        <div class="col-12 col-md-4 col-lg-3">
          <label class="form-label fw-bold small" for="f-sort">Sort by</label>
          <select class="form-select" id="f-sort" name="sort">
            <% for (const [key, label] of Object.entries(sorts)) { %>
              <option value="<%= key %>" <%= (filters.sort || "recommended") === key ? "selected" : "" %>><%= label %></option>
            <% } %>
          </select>
        </div>
        <fieldset class="col-12 wl-fieldset">
          <legend class="form-label fw-bold small">Amenities</legend>
          <div class="wl-check-grid">
            <%# Pets and workspace are under Guest needs below %>
            <% for (const [key, info] of Object.entries(amenityInfo).filter(([key]) => !["pets_allowed", "workspace"].includes(key))) { %>
            <label class="wl-check wl-check--small">
              <input type="checkbox" name="amenities" value="<%= key %>" <%= (filters.amenities || []).includes(key) ? "checked" : "" %> />
              <span><%= info[0] %></span>
            </label>
            <% } %>
          </div>
        </fieldset>
        <%- include("../includes/guestNeedsFilter.ejs", { filters, guestNeeds }) %>
      </div>
      <div class="d-flex justify-content-end gap-2 mt-3">
        <a href="/listings" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset All</a>
        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">Apply Filters</button>
      </div>
    </form>
  </div>

  <!-- Empty State -->
  <% if (!allListings.length) { %>
    <div class="wl-empty">
      <h3 class="wl-empty__title">No stays found</h3>
      <p class="wl-empty__text">Try different dates, a wider price range or fewer filters.</p>
      <a href="/listings" class="wl-auth-btn wl-auth-btn--outline">Clear all filters</a>
    </div>
  <% } %>

  <!-- 4-Column Desktop Property Card Grid -->
  <div class="row row-cols-xxl-4 row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% for (let listing of allListings) { %>
      <div class="col">
        <%- include("../includes/listingCard.ejs", { listing, eager: listing === allListings[0] }) %>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <% if (pages > 1 && allListings.length) { %>
    <div class="d-flex justify-content-center pb-5">
      <%- include("../includes/pagination.ejs", { base: "/listings" }) %>
    </div>
  <% } %>
</section>

<!-- ==============================================
     EDITORIAL PANELS (MAP, UNIQUE STAYS, HOSTING)
     ============================================== -->
<section class="wl-editorial-panels-section mt-2 mb-5">
  <div class="row g-4">
    <!-- Panel 1: Destinations -->
    <div class="col-12 col-lg-6">
      <div class="wl-editorial-card wl-card-destinations glass-surface">
        <img
          src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80"
          alt=""
          class="wl-editorial-bg"
          loading="lazy"
        />
        <div class="wl-editorial-overlay">
          <div class="wl-editorial-copy">
            <span class="wl-editorial-eyebrow">MAP</span>
            <h3 class="wl-editorial-title">See every stay<br />on the map.</h3>
          </div>
          <a href="/listings/map" class="wl-editorial-arrow-btn" aria-label="Open the map">
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Panel 2: Experiences -->
    <div class="col-12 col-lg-6">
      <div class="wl-editorial-card wl-card-experiences glass-surface">
        <img
          src="https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=800&q=80"
          alt=""
          class="wl-editorial-bg"
          loading="lazy"
        />
        <div class="wl-editorial-overlay">
          <div class="wl-editorial-copy">
            <span class="wl-editorial-eyebrow">UNIQUE STAYS</span>
            <h3 class="wl-editorial-title">Treehouses, castles and tiny homes</h3>
          </div>
          <a href="/listings?category=Unique%20Stays" class="wl-editorial-arrow-btn" aria-label="Browse unique stays">
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
