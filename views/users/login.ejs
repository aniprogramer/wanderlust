<% layout("/layouts/boilerplate") %>
<main class="wl-auth" id="main-content">
  <%- include("../includes/auth/hero") %>

  <div class="wl-auth-panel">
    <div class="wl-auth-card">
      <%- include("../includes/auth/mark", { size: 44, cls: "wl-auth-card__mark" }) %>
      <h1 class="wl-auth-card__title">Welcome back</h1>
      <p class="wl-auth-card__sub">Sign in to continue your journey.</p>

      <form action="/login" method="POST" class="wl-auth-form" data-auth-form data-busy-label="Signing in…" novalidate>
        <%- include("../includes/csrf.ejs") %>
        <%- include("../includes/auth/field", { id: "username", name: "username", label: "Email or username", noun: "email or username", icon: "fa-regular fa-envelope", placeholder: "Enter your email or username", autocomplete: "username" }) %>
        <%- include("../includes/auth/field", { id: "password", name: "password", label: "Password", type: "password", icon: "fa-solid fa-lock", placeholder: "Enter your password", autocomplete: "current-password", maxlength: 128 }) %>

        <div class="wl-auth-helpers">
          <div class="wl-check m-0">
            <input type="checkbox" id="rememberMe" name="rememberMe" value="on" checked />
            <label for="rememberMe">Remember me</label>
          </div>
          <a class="wl-auth-link wl-auth-forgot" href="/forgot-password">Forgot password?</a>
        </div>

        <button type="submit" class="wl-auth-btn wl-auth-btn--primary wl-auth-btn--block">
          <span data-btn-label>Sign in</span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
      </form>

      <hr class="wl-auth-rule" />

      <p class="wl-auth-switch">
        New to Wanderlust?
        <a class="wl-auth-link" href="/signup">Create an account <i class="fa-solid fa-arrow-right small" aria-hidden="true"></i></a>
      </p>
    </div>

    <%- include("../includes/auth/footer") %>
  </div>
</main>
