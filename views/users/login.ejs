<% layout("/layouts/boilerplate") %>
<body>
  <h1 style="text-align: center" class="mt-2">Login to Wanderlust</h1>
  <div class="row mt-3">
    <div class="col-6 offset-3">
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            required
          />
        </div>

        <button type="submit" class="btn btn-dark wanderlust-btn">Login</button>
      </form>
    </div>
  </div>
</body>
