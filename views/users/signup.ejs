<% layout("/layouts/boilerplate") %>
<main class="wl-auth" id="main-content">
  <%- include("../includes/auth/hero") %>

  <div class="wl-auth-panel">
    <div class="wl-auth-card">
      <%- include("../includes/auth/mark", { size: 44, cls: "wl-auth-card__mark" }) %>
      <h1 class="wl-auth-card__title">Create your account</h1>
      <p class="wl-auth-card__sub">Join Wanderlust and start exploring.</p>

      <form action="/signup" method="POST" class="wl-auth-form wl-auth-form--compact" data-auth-form data-match="confirmPassword" data-busy-label="Creating account…" novalidate>
        <%- include("../includes/csrf.ejs") %>

        <div class="wl-auth-row">
          <%- include("../includes/auth/field", { id: "firstName", name: "firstName", label: "First name", labelHidden: true, icon: "fa-regular fa-user", placeholder: "First name", autocomplete: "given-name", optional: true }) %>
          <%- include("../includes/auth/field", { id: "lastName", name: "lastName", label: "Last name", labelHidden: true, icon: "fa-regular fa-user", placeholder: "Last name", autocomplete: "family-name", optional: true }) %>
        </div>

        <%- include("../includes/auth/field", { id: "email", name: "email", label: "Email address", labelHidden: true, type: "email", icon: "fa-regular fa-envelope", placeholder: "Email address", autocomplete: "email" }) %>
        <%- include("../includes/auth/field", { id: "username", name: "username", label: "Username", labelHidden: true, icon: "fa-solid fa-at", placeholder: "Username", autocomplete: "username", maxlength: 30, minlength: 3, checkUsername: true }) %>
        <%- include("../includes/auth/field", { id: "password", name: "password", label: "Password", labelHidden: true, type: "password", icon: "fa-solid fa-lock", placeholder: "Password", autocomplete: "new-password", maxlength: 128, minlength: 8, describedBy: "password-rules", newPassword: true }) %>
        <%- include("../includes/auth/passwordRules", { target: "password" }) %>
        <%- include("../includes/auth/field", { id: "confirmPassword", name: "confirmPassword", label: "Confirm password", labelHidden: true, type: "password", icon: "fa-solid fa-lock", placeholder: "Confirm password", autocomplete: "new-password", maxlength: 128 }) %>

        <fieldset class="wl-segmented wl-segmented--stacked" data-required-radio="Choose whether you want to find stays or host stays." id="startingMode">
          <legend class="wl-segmented__legend">I want to:</legend>
          <div class="wl-segmented__options">
            <label class="wl-segmented__option">
              <input type="radio" name="startingMode" value="guest" />
              <span class="wl-segmented__label">
                <span class="wl-segmented__title"><i class="fa-solid fa-bed wl-segmented__icon" aria-hidden="true"></i> Find stays</span>
                <span class="wl-segmented__hint">Browse places and send requests to hosts.</span>
                <span class="wl-segmented__badge" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
              </span>
            </label>
            <label class="wl-segmented__option">
              <input type="radio" name="startingMode" value="host" />
              <span class="wl-segmented__label">
                <span class="wl-segmented__title"><i class="fa-solid fa-house wl-segmented__icon" aria-hidden="true"></i> Host stays</span>
                <span class="wl-segmented__hint">List your property and welcome guests.</span>
                <span class="wl-segmented__badge" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
              </span>
            </label>
          </div>
          <p class="wl-segmented__note wl-field__hint">One account does both. You can switch at any time.</p>
          <p class="wl-field__error" id="startingMode-error" hidden></p>
        </fieldset>

        <div class="wl-check wl-auth-terms">
          <input type="checkbox" id="terms" name="terms" value="on" required data-required-check="Accept the Terms and Privacy Policy to create an account." />
          <label for="terms">I agree to the <a class="wl-auth-link" href="/terms" target="_blank" rel="noopener">Terms of Service</a> and <a class="wl-auth-link" href="/privacy" target="_blank" rel="noopener">Privacy Policy</a></label>
        </div>
        <p class="wl-field__error" id="terms-error" hidden></p>

        <button type="submit" class="wl-auth-btn wl-auth-btn--primary wl-auth-btn--block">
          <span data-btn-label>Create account</span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
      </form>

      <hr class="wl-auth-rule" />

      <p class="wl-auth-switch">
        Already a member?
        <a class="wl-auth-link" href="/login">Sign in <i class="fa-solid fa-arrow-right small" aria-hidden="true"></i></a>
      </p>
    </div>

    <%- include("../includes/auth/footer") %>
  </div>
</main>
