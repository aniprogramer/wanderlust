<%# Expects: base (path), page, pages, qs(overrides) %>
<% if (pages > 1) { %>
<% const basePath = typeof base !== "undefined" ? base : ""; %>
<nav aria-label="Pagination" class="wl-pagination-nav mb-4">
  <ul class="pagination wl-pagination justify-content-center flex-wrap m-0 p-0">
    <!-- Previous Button -->
    <li class="page-item wl-page-prev <%= page <= 1 ? 'disabled' : '' %>">
      <% if (page <= 1) { %>
        <span class="page-link" aria-disabled="true" tabindex="-1">
          <i class="fa-solid fa-chevron-left me-1" aria-hidden="true"></i> Previous
        </span>
      <% } else { %>
        <a class="page-link" href="<%= basePath %><%= qs({ page: page - 1 }) %>" aria-label="Previous page">
          <i class="fa-solid fa-chevron-left me-1" aria-hidden="true"></i> Previous
        </a>
      <% } %>
    </li>

    <% 
      const startPage = Math.max(1, page - 2);
      const endPage = Math.min(pages, page + 2);
    %>

    <% if (startPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="<%= basePath %><%= qs({ page: 1 }) %>" aria-label="Page 1">1</a>
      </li>
      <% if (startPage > 2) { %>
        <li class="page-item disabled" aria-hidden="true">
          <span class="page-link wl-page-ellipsis">&hellip;</span>
        </li>
      <% } %>
    <% } %>

    <% for (let p = startPage; p <= endPage; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>" <%= p === page ? 'aria-current="page"' : '' %>>
        <a class="page-link" href="<%= basePath %><%= qs({ page: p }) %>" aria-label="Page <%= p %>"><%= p %></a>
      </li>
    <% } %>

    <% if (endPage < pages) { %>
      <% if (endPage < pages - 1) { %>
        <li class="page-item disabled" aria-hidden="true">
          <span class="page-link wl-page-ellipsis">&hellip;</span>
        </li>
      <% } %>
      <li class="page-item">
        <a class="page-link" href="<%= basePath %><%= qs({ page: pages }) %>" aria-label="Page <%= pages %>"><%= pages %></a>
      </li>
    <% } %>

    <!-- Next Button -->
    <li class="page-item wl-page-next <%= page >= pages ? 'disabled' : '' %>">
      <% if (page >= pages) { %>
        <span class="page-link" aria-disabled="true" tabindex="-1">
          Next <i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i>
        </span>
      <% } else { %>
        <a class="page-link" href="<%= basePath %><%= qs({ page: page + 1 }) %>" aria-label="Next page">
          Next <i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i>
        </a>
      <% } %>
    </li>
  </ul>
</nav>
<% } %>
