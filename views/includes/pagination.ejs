<%# Expects: base (path), page, pages, qs(overrides) %>
<% if (pages > 1) { %>
<nav aria-label="Pagination" class="mb-4">
  <ul class="pagination justify-content-center flex-wrap">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="<%= base %><%= qs({ page: page - 1 }) %>">Previous</a>
    </li>
    <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p++) { %>
    <li class="page-item <%= p === page ? 'active' : '' %>">
      <a class="page-link" href="<%= base %><%= qs({ page: p }) %>"><%= p %></a>
    </li>
    <% } %>
    <li class="page-item <%= page >= pages ? 'disabled' : '' %>">
      <a class="page-link" href="<%= base %><%= qs({ page: page + 1 }) %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>
