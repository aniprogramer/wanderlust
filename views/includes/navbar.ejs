<nav class="navbar navbar-expand-xl wl-navbar sticky-top py-2 px-3 mb-4" aria-label="Site">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/listings" aria-label="Wanderlust Home">
      <%- include("./auth/mark", { size: 30, cls: "wl-brand-mark-gold" }) %>
      <span class="wl-wordmark fs-4">
        Wanderlust
      </span>
    </a>

    <button
      class="navbar-toggler border-0"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Menu"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Primary nav links -->
      <div class="navbar-nav wl-nav-primary me-auto align-items-lg-center">
        <% (currUser ? navLinks : navLinks.slice(0, 2)).forEach((link) => { %>
        <% const here = currentPath === link.href; %>
        <a class="nav-link px-3<%= here ? ' active' : '' %>" href="<%= link.href %>"<%- here ? ' aria-current="page"' : '' %>><%= link.label %></a>
        <% }) %>
      </div>

      <!-- Center Capsule Search -->
      <div class="navbar-nav mx-auto my-2 my-xl-0">
        <form class="wl-navsearch" role="search" action="/listings" method="GET">
          <i class="fa-solid fa-magnifying-glass wl-navsearch__icon" aria-hidden="true"></i>
          <input
            class="wl-navsearch__input"
            type="search"
            name="q"
            maxlength="100"
            placeholder="Search destinations"
            aria-label="Search destinations"
            id="nav-search"
            autocomplete="off"
          />
          <button class="wl-navsearch__btn" type="submit">Search</button>
        </form>
      </div>

      <!-- Right Actions: Currency, Mode, User Menu -->
      <div class="navbar-nav ms-auto align-items-lg-center gap-2">
        <%- include("./currencyDropdown") %>

        <% if (!currUser) { %>
          <a class="nav-link px-2" href="/signup"><b>Sign up</b></a>
          <a class="nav-link px-2" href="/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <%- include("./modeSwitch", { cls: "wl-auth-btn wl-auth-btn--outline wl-mode-btn" }) %>

          <!-- User dropdown menu -->
          <div class="dropdown ms-lg-2">
            <button
              class="wl-hero-avatar-btn glass-action"
              type="button"
              id="userMenuBtnNav"
              data-bs-toggle="dropdown"
              data-bs-offset="[0, 8]"
              aria-expanded="false"
              aria-label="User Account Menu"
            >
              <div class="wl-avatar-circle user-logged-in">
                <%= currUser.username.slice(0, 1).toUpperCase() %>
              </div>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg glass-dropdown wl-dropdown-menu" aria-labelledby="userMenuBtnNav">
              <li class="dropdown-header fw-bold">Hello, <%= currUser.username %></li>
              <li><a class="dropdown-item py-2" href="/users/<%= encodeURIComponent(currUser.username) %>"><i class="fa-regular fa-id-card me-2" aria-hidden="true"></i>Profile</a></li>
              <% if (currUser.isAdmin) { %>
                <li><a class="dropdown-item py-2" href="/admin"><i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>Admin</a></li>
              <% } %>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <form action="/logout" method="POST" class="m-0">
                  <%- include("./csrf.ejs") %>
                  <button type="submit" class="dropdown-item py-2 wl-dropdown-item-danger"><b>Log out</b></button>
                </form>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
