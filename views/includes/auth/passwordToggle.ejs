<% if (typeof confirm !== "undefined" && confirm) { %>
<button type="button" class="wl-input__toggle" data-toggle-confirm-password aria-controls="<%= target %>" aria-pressed="false" aria-label="Show password">
  <i class="fa-regular fa-eye" aria-hidden="true"></i>
</button>
<% } else { %>
<button type="button" class="wl-input__toggle" data-toggle-password aria-controls="<%= target %>" aria-pressed="false" aria-label="Show password">
  <i class="fa-regular fa-eye" aria-hidden="true"></i>
</button>
<% } %>
