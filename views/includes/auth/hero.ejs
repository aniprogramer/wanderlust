<section class="wl-auth-hero" aria-labelledby="auth-hero-title">
  <img
    class="wl-auth-hero__photo"
    src="/images/santorini.jpg"
    width="1150"
    height="1314"
    alt="Whitewashed hillside village of Oia, Santorini, glowing at sunset above the Aegean"
    fetchpriority="high"
  />
  <div class="wl-auth-hero__top">
    <a class="wl-auth-brand" href="/listings" aria-label="Wanderlust home">
      <%- include("./mark", { size: 36, cls: "wl-mark--band" }) %>
      <span class="wl-auth-brand__word">Wanderlust</span>
    </a>
    <p class="wl-auth-eyebrow">
      <span>Homes</span><span aria-hidden="true">·</span><span>Cabins</span><span aria-hidden="true">·</span><span>Villas</span>
    </p>
  </div>
  <div class="wl-auth-hero__copy">
    <h2 class="wl-auth-headline" id="auth-hero-title">
      More than a stay.<br />A more meaningful<br />way to <em>explore.</em>
    </h2>
    <p class="wl-auth-lede">
      Homes, cabins and villas around the world. Send a request and the host confirms your stay.
    </p>
  </div>
  <figure class="wl-auth-caption">
    <span class="wl-auth-caption__rule" aria-hidden="true"></span>
    <p class="wl-auth-caption__place">Santorini, Greece</p>
  </figure>
</section>
