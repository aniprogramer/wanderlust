<% if (errorMsg && errorMsg.length) { %>
  <div class="wl-auth-alert wl-auth-alert--error" role="alert" id="form-error" tabindex="-1">
    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
    <span><strong>Error:</strong> <%= errorMsg %></span>
  </div>
<% } %>
<% if (successMsg && successMsg.length) { %>
  <div class="wl-auth-alert wl-auth-alert--success" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    <span><%= successMsg %></span>
  </div>
<% } %>
<% if (typeof infoMsg !== "undefined" && infoMsg && infoMsg.length) { %>
  <div class="wl-auth-alert wl-auth-alert--info" role="status">
    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
    <span><%= infoMsg %></span>
  </div>
<% } %>
