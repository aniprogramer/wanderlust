<%# The live checklist under a new-password field. The rules and their patterns come from
    utils/passwordRules.js, the same list the server enforces. %>
<ul class="wl-rules" id="<%= target %>-rules" data-password-rules="<%= target %>" aria-label="Password requirements">
  <% passwordRules.forEach((rule) => { %>
  <li class="wl-rules__item" data-rule="<%= rule.id %>" data-pattern="<%= rule.pattern %>">
    <i class="fa-regular fa-circle wl-rules__icon" aria-hidden="true"></i>
    <span><%= rule.label %></span>
    <span class="visually-hidden" data-rule-state>, not met yet</span>
  </li>
  <% }) %>
</ul>
