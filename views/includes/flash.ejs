<%#
  Success and info messages fade after 5 seconds and pause on hover or focus (flash.js).
  Errors and warnings stay until closed.
%>
<% const flashes = [
  { type: "success", messages: successMsg, icon: "fa-circle-check", live: true },
  { type: "info", messages: typeof infoMsg === "undefined" ? [] : infoMsg, icon: "fa-circle-info", live: true },
  { type: "warning", messages: typeof warningMsg === "undefined" ? [] : warningMsg, icon: "fa-triangle-exclamation", live: false },
  { type: "error", messages: errorMsg, icon: "fa-circle-exclamation", live: false },
]; %>
<div class="wl-flash-stack">
<% if (currUser && !currUser.emailVerifiedAt) { %>
  <div class="wl-auth-alert wl-auth-alert--info wl-banner" data-verify-banner>
    <i class="fa-solid fa-envelope" aria-hidden="true"></i>
    <span class="wl-flash__text">Please confirm your email address. You need this to send a request or list a stay. <a class="wl-auth-link" href="/verify-email">Resend the link</a></span>
    <button type="button" class="wl-flash__close" data-flash-close aria-label="Dismiss until the next page">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>
<% } %>
<% for (const flash of flashes) { %>
  <% if (flash.messages && flash.messages.length) { %>
  <div
    class="wl-auth-alert wl-auth-alert--<%= flash.type %> wl-flash"
    role="<%= flash.live ? 'status' : 'alert' %>"
    <%= flash.live ? 'data-autodismiss' : '' %>
  >
    <i class="fa-solid <%= flash.icon %>" aria-hidden="true"></i>
    <span class="wl-flash__text"><%= flash.messages %></span>
    <button type="button" class="wl-flash__close" data-flash-close aria-label="Dismiss message">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>
  <% } %>
<% } %>
</div>
