<% const badge = cardBadge(listing); %>
<div class="listing-card wl-listing-card position-relative" id="l-<%= listing._id %>">
  <!-- Visual Media Container -->
  <div class="wl-card-media-wrapper">
    <a href="/listings/<%= listing._id %>" class="wl-card-media-link" aria-label="<%= listing.title %>">
      <img
        src="<%= photoUrl(listing.image.url, 400) %>"
        srcset="<%= photoSrcset(listing.image.url, [400, 800]) %>"
        sizes="(max-width: 575px) 100vw, (max-width: 1024px) 50vw, 400px"
        class="wl-card-img"
        alt="<%= listing.title %>"
        <% if (typeof eager !== "undefined" && eager) { %>fetchpriority="high"<% } else { %>loading="lazy"<% } %>
      />
    </a>

    <% if (badge) { %><div class="wl-card-badge"><%= badge %></div><% } %>

    <!-- Top-right Wishlist Heart Button -->
    <% const saved = (typeof savedIds !== 'undefined' && savedIds) ? savedIds.has(String(listing._id)) : false; %>
    <% if (!currUser) { %>
      <div class="wish-form wl-wish-wrapper">
        <a href="/login" class="wish-btn wl-wish-btn" aria-label="Log in to save">
          <i class="fa-regular fa-heart" aria-hidden="true"></i>
        </a>
      </div>
    <% } else { %>
      <form
        action="/wishlist/<%= listing._id %><%= saved ? '?_method=DELETE' : '' %>"
        method="POST"
        class="wish-form wl-wish-wrapper"
      >
        <%- include("./csrf.ejs") %>
        <button
          type="submit"
          class="wish-btn wl-wish-btn <%= saved ? 'saved' : '' %>"
          aria-label="<%= saved ? 'Remove from wishlist' : 'Save to wishlist' %>"
          aria-pressed="<%= saved %>"
        >
          <i class="<%= saved ? 'fa-solid' : 'fa-regular' %> fa-heart" aria-hidden="true"></i>
        </button>
      </form>
    <% } %>
  </div>

  <!-- Card Body & Metadata -->
  <div class="wl-card-body card-body">
    <!-- Row 1: Title and rating. Real numbers only (FR-19). -->
    <div class="wl-card-header d-flex justify-content-between align-items-start gap-2">
      <a href="/listings/<%= listing._id %>" class="wl-title-link text-decoration-none">
        <p class="card-text mb-0">
          <b class="wl-card-title"><%= listing.title %></b>
        </p>
      </a>
      <% if (listing.reviewCount) { %>
        <div class="wl-card-rating d-flex align-items-center gap-1 flex-shrink-0">
          <i class="fa-solid fa-star wl-star-amber" aria-hidden="true"></i>
          <span class="wl-rating-num"><%= listing.avgRating.toFixed(1) %></span>
          <span class="wl-reviews-count">(<%= listing.reviewCount %><span class="visually-hidden"> review<%= listing.reviewCount === 1 ? "" : "s" %></span>)</span>
        </div>
      <% } else if (isRecentlyListed(listing)) { %>
        <span class="wl-badge wl-badge--neutral flex-shrink-0">New</span>
      <% } else { %>
        <span class="wl-reviews-count flex-shrink-0">No reviews yet</span>
      <% } %>
    </div>

    <!-- Row 2: Location -->
    <div class="wl-card-location">
      <i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>
      <span><%= listing.location %>, <%= listing.country %></span>
    </div>

    <% if (listing.category || listing.propertyType) { %>
    <div class="wl-card-amenities">
      <% if (listing.propertyType) { %><span><%= listing.propertyType %></span><% } %>
      <% if (listing.category) { %><span><%= listing.category %></span><% } %>
    </div>
    <% } %>

    <!-- Row 4: Pricing and Arrow Action -->
    <div class="wl-card-footer d-flex justify-content-between align-items-center">
      <div class="wl-card-price-block">
        <span class="wl-price-amount"><%= money(listing.price, listing.currency) %></span>
        <span class="wl-price-period">/ night</span>
      </div>
      <a href="/listings/<%= listing._id %>" class="wl-card-action-btn" aria-label="View <%= listing.title %>">
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>
