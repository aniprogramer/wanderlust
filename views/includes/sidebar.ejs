<!-- Wanderlust Liquid Glass Floating Navigation Rail -->
<aside class="wl-sidebar">
  <div class="wl-sidebar-inner d-flex flex-column align-items-center justify-content-start py-4">
    <!-- Floating Liquid Glass Rail Dock -->
    <nav class="wl-nav-rail glass-navigation" aria-label="Primary Navigation">
      <ul class="wl-rail-list wl-nav-list m-0 p-0 list-unstyled d-flex flex-column align-items-center">
        <% (navLinks || []).forEach((link) => { 
             const isActive = currentPath === link.href || (link.href !== '/listings' && currentPath.startsWith(link.href));
             const iconCls = link.label === "Saved" ? "fa-regular fa-heart" : link.icon;
        %>
        <li class="wl-rail-item wl-nav-item">
          <a
            href="<%= link.href %>"
            class="wl-rail-link wl-nav-link <%= isActive ? 'active' : '' %>"
            aria-label="<%= link.label %>"
            title="<%= link.label %>"
          >
            <div class="wl-rail-icon-wrap">
              <i class="<%= iconCls %>" aria-hidden="true"></i>
            </div>
            <span class="wl-rail-label"><%= link.label %></span>
          </a>
        </li>
        <% }); %>

        <!-- Profile Link (for guests and visitors) -->
        <% if (typeof mode === 'undefined' || mode !== 'host') { %>
        <li class="wl-rail-item">
          <% const profileHref = currUser ? `/users/${encodeURIComponent(currUser.username)}` : '/login'; %>
          <a
            href="<%= profileHref %>"
            class="wl-rail-link <%= currentPath.startsWith('/users') ? 'active' : '' %>"
            aria-label="<%= currUser ? 'Your profile' : 'Sign in to profile' %>"
            title="Profile"
          >
            <div class="wl-rail-icon-wrap">
              <i class="fa-regular fa-user" aria-hidden="true"></i>
            </div>
            <span class="wl-rail-label">Profile</span>
          </a>
        </li>
        <% } %>
      </ul>
    </nav>
  </div>
</aside>
