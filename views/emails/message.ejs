<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= subject %></title>
  </head>
  <body style="margin:0;padding:0;background-color:<%= theme.bg %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:<%= theme.bg %>;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;">
            <tr>
              <td style="padding:0 0 24px;">
                <img src="<%= logoUrl %>" width="28" height="28" alt="" style="vertical-align:middle;border:0;" />
                <span style="font-family:<%- theme.fontDisplay %>;font-size:24px;color:<%= theme.text %>;vertical-align:middle;">&nbsp;Wanderlust</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;background-color:<%= theme.surface %>;border:1px solid <%= theme.border %>;border-radius:<%= theme.radiusMd %>;">
                <h1 style="margin:0 0 16px;font-family:<%- theme.fontDisplay %>;font-size:30px;line-height:1.1;font-weight:400;color:<%= theme.text %>;"><%= heading %></h1>
                <% for (const line of lines) { %>
                <p style="margin:0 0 16px;font-family:<%- theme.fontSans %>;font-size:16px;line-height:1.6;color:<%= theme.textSecondary %>;"><%= line %></p>
                <% } %>
                <% if (facts.length) { %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;border-top:1px solid <%= theme.border %>;">
                  <% for (const [label, value] of facts) { %>
                  <tr>
                    <td style="padding:8px 8px 8px 0;border-bottom:1px solid <%= theme.border %>;font-family:<%- theme.fontSans %>;font-size:14px;color:<%= theme.textMuted %>;"><%= label %></td>
                    <td align="right" style="padding:8px 0;border-bottom:1px solid <%= theme.border %>;font-family:<%- theme.fontSans %>;font-size:14px;color:<%= theme.text %>;"><%= value %></td>
                  </tr>
                  <% } %>
                </table>
                <% } %>
                <% if (action) { %>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
                  <tr>
                    <td style="background-color:<%= theme.primary %>;border-radius:<%= theme.radiusLg %>;">
                      <a href="<%= action.url %>" style="display:inline-block;padding:14px 24px;font-family:<%- theme.fontSans %>;font-size:16px;font-weight:600;color:<%= theme.onPrimary %>;text-decoration:none;"><%= action.label %></a>
                    </td>
                  </tr>
                </table>
                <% } %>
                <% if (note) { %>
                <p style="margin:16px 0 0;font-family:<%- theme.fontSans %>;font-size:14px;line-height:1.5;color:<%= theme.textMuted %>;"><%= note %></p>
                <% } %>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 0 0;font-family:<%- theme.fontSans %>;font-size:13px;line-height:1.5;color:<%= theme.textMuted %>;">
                You are receiving this because of your Wanderlust account. Questions? <a href="<%= helpUrl %>" style="color:<%= theme.link %>;">Contact us</a>.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
