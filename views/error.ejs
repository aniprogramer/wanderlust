<% layout("/layouts/boilerplate") %>
<div class="wl-page wl-page--read">
  <div class="wl-empty">
    <h1 class="wl-empty__title"><%= err.statusCode === 404 ? "We couldn't find that page" : (err.statusCode >= 500 || !err.statusCode ? "Something went wrong on our side" : "That didn't work") %></h1>
    <p class="wl-empty__text"><%= err.message %></p>
    <a class="wl-auth-btn wl-auth-btn--outline" href="/listings">Back to stays</a>
  </div>
</div>
