<% layout("/layouts/boilerplate") %>
<header class="wl-page-head">
  <div>
    <h1 class="wl-page-title">Saved</h1>
    <p class="wl-page-lede"><%= allListings.length ? `${allListings.length} ${allListings.length === 1 ? "stay" : "stays"} kept for later.` : "Stays you keep for later." %></p>
  </div>
</header>
<% if (!allListings.length) { %>
<div class="wl-empty">
  <span class="wl-state__icon" aria-hidden="true"><i class="fa-regular fa-heart"></i></span>
  <h2 class="wl-empty__title">Nothing saved yet</h2>
  <p class="wl-empty__text">Tap the heart on any stay to keep it here.</p>
  <a href="/listings" class="wl-auth-btn wl-auth-btn--primary">Explore stays</a>
</div>
<% } %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">
  <% for (let listing of allListings) { %>
  <div class="col"><%- include("../includes/listingCard.ejs", { listing }) %></div>
  <% } %>
</div>
