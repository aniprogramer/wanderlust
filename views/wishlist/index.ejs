<% layout("/layouts/boilerplate") %>
<h3 class="my-4">My Wishlist</h3>
<% if (!allListings.length) { %>
<div class="text-center text-muted py-5">
  <i class="fa-regular fa-heart fs-1"></i>
  <p class="mt-3">Nothing saved yet. Tap the heart on any stay to keep it here.</p>
  <a href="/listings" class="btn btn-dark wanderlust-btn">Explore stays</a>
</div>
<% } %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">
  <% for (let listing of allListings) { %>
  <div class="col"><%- include("../includes/listingCard.ejs", { listing }) %></div>
  <% } %>
</div>
