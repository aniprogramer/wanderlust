# Placeholders only. Copy to .env for local work; in production the host provides these.
PORT=8080
NODE_ENV=development
ATLAS=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wanderlust?retryWrites=true&w=majority
SECRET=your_long_random_session_secret_key

# Photos
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Public Mapbox token (pk.*). Restrict it to your site URL in the Mapbox dashboard.
MAPBOX_TOKEN=your_mapbox_public_access_token
# Secret Mapbox token (sk.*) for server-side geocoding. Optional: falls back to MAPBOX_TOKEN.
MAPBOX_SERVER_TOKEN=your_mapbox_secret_access_token

# Public site URL, used in emails, canonical links and the sitemap (no trailing slash)
APP_URL=http://localhost:8080
# Decides what "today" is. Stays are calendar dates.
APP_TIMEZONE=Asia/Kolkata

# Email. Required in production. Without SMTP_HOST in development nothing is sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=Wanderlust <no-reply@example.com>
# Receives contact messages and listing reports; shown on the Help and Contact pages
SUPPORT_EMAIL=support@example.com

# Legal pages show bracketed placeholders until these are set. Do not invent them.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
GRIEVANCE_OFFICER=
GOVERNING_LAW=
# Set to true only after a lawyer has reviewed views/legal. It removes the draft notice.
LEGAL_REVIEWED=false

# Footer icons appear only for the links that are set
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=

# Seed script safety. See README.
ALLOW_DESTRUCTIVE_SEED=false
# Comma-separated strings. A database URL containing any of them can never be wiped.
PROTECTED_DB_MARKERS=mongodb.net,prod

# Optional error tracking. Empty means errors go to the logs only.
SENTRY_DSN=
